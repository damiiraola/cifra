# Copiá esto a Vercel → Settings → Environment Variables.
# Nunca commitees valores reales.

DATABASE_URL=
BETTER_AUTH_URL=https://cifra.lol
BETTER_AUTH_SECRET=
VITE_AUTH_ENABLED=true
RESEND_API_KEY=
MAIL_FROM=Cifra <hola@cifra.lol>
# Asistente IA (Vercel AI Gateway). En Vercel NO hace falta: usa el token OIDC
# del proyecto. Ponelo solo si querés una clave propia (vercel.com → AI Gateway → API Keys)
# o para probar en local (o corré `vercel env pull` para tener VERCEL_OIDC_TOKEN).
AI_GATEWAY_API_KEY=
# Opcional: modelo del Gateway (default spacexai/grok-4.1-fast-non-reasoning).
AI_MODEL=
# Opcional: respaldo gratis en Groq (console.groq.com → API Keys).
GROQ_API_KEY=
GROQ_MODEL=
# Opcional: preguntas por usuario por día (default 30; 0 = asistente apagado).
AI_DAILY_LIMIT=
# Opcional: prende /api/mail-drill (POST + Authorization: Bearer <token>).
# Dejalo vacío para que la ruta dé 404. Generalo con: openssl rand -hex 32
MAIL_DRILL_TOKEN=
# Avisos por mail (opcional, apagado si falta alguna): ALERT_MAILS_ENABLED=1 y un CRON_SECRET largo.
ALERT_MAILS_ENABLED=
CRON_SECRET=
